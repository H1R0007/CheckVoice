# ============================================
# ЧекВойс — настройки приложения
# ============================================
#
# 1. Скопируйте этот файл как .env
# 2. Заполните значения
# 3. При изменении .env — перезапустите приложение (Ctrl+C → npm start)
#

# Токен из SmartApp Studio
# Профиль → Настройки профиля → Настройки сервисов → Эмулятор → Скопировать ключ
REACT_APP_TOKEN=""

# Название CanvasApp (ТОЧНО как в SmartApp Studio)
REACT_APP_SMARTAPP=""

# Не открывать браузер автоматически при запуске
BROWSER=none