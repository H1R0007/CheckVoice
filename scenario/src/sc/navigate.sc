theme: /

    state: НавигацияЧек
        q!: (новый|текущий|открой) [~чек|~список]
        q!: (~вернуться|вернись|назад) [к чеку]
        q!: на главную

        script:
            navigateTo("newReceipt", $context);
            $reactions.answer("Возвращаюсь к чеку.");

    state: НавигацияИстория
        q!: (покажи|открой) [~история|~чеки|~прошлые]
        q!: ~история [~чеков|~покупок]
        q!: мои [~чеки|~покупки]

        script:
            navigateTo("history", $context);
            $reactions.answer("Открываю историю.");
    
    state: НавигацияНастройки
        q!: (покажи|открой) [~параметры]
        q!: ~настройки
        q!: параметры [приложения]
        q!: конфигурация

        script:
            navigateTo("settings", $context);
            $reactions.answer("Открываю настройки.");

    state: НавигацияСтатистика
        q!: (покажи|открой) [~статистика|~аналитика]
        q!: ~статистика [~расходов|~покупок]

        script:
            navigateTo("statistics", $context);
            $reactions.answer("Показываю статистику.");

    state: ОткрытьПоследнийЧек
        q!: (открой|покажи) (последний|предыдущий|прошлый) [~чек]
        q!: последний чек

        script:
            openLastReceipt($context);

    state: РедактироватьПоследнийЧек
        q!: (~редактировать|редактируй|~изменить) (последний|предыдущий) [~чек]
        q!: редактируй [последний] чек
        q!: загрузи (последний|предыдущий) чек [для редактирования]

        script:
            editLastReceipt($context);
            $reactions.answer("Загружаю чек для редактирования.");

    state: УдалитьПоследнийЧек
        q!: (~удалить|удали) (последний|предыдущий) [~чек]

        script:
            deleteLastReceipt($context);

    state: ЭкспортДанных
        q!: (~экспортировать|экспортируй|~выгрузить|выгрузи) [~данные|~чеки]

        script:
            exportData($context);
            $reactions.answer("Экспортирую данные.");