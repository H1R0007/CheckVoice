theme: /

    state: НавигацияЧек
        q!: (новый|текущий|открой) [~чек|~список]
        q!: (~вернуться|вернись|назад) [к|на|в] [~чек|~начало|~главную]
        q!: ~начало

        script:
            navigateTo("newReceipt", $context);

    state: НавигацияИстория
        q!: (покажи|открой) [~история|~чеки|~прошлые|~сохранённые]
        q!: ~история [~чеков|~покупок]
        q!: мои [~чеки|~покупки]

        script:
            navigateTo("history", $context);

    state: НавигацияСтатистика
        q!: (покажи|открой|озвучь) [~статистика|~аналитика]
        q!: ~статистика [~расходов|~покупок|~трат]
        q!: (покажи|открой) [мои] [~расходы|~траты]

        script:
            navigateTo("statistics", $context);

    state: НавигацияНастройки
        q!: (покажи|открой) [~настройки|~параметры]
        q!: ~настройки
        q!: ~экспорт [~данных|~данные]

        script:
            navigateTo("settings", $context);

    state: ОткрытьПоследнийЧек
        q!: (открой|покажи) (последний|предыдущий|прошлый) [~чек|~покупки]
        q!: что [я] (купил|купила|покупал|покупала) [в] (прошлый|последний) [раз]

        script:
            addAction({ type: "open_last_receipt" }, $context);

    state: РедактироватьПоследнийЧек
        q!: (~редактировать|редактируй|~изменить|измени) (последний|предыдущий|прошлый) [~чек]

        script:
            addAction({ type: "edit_last_receipt" }, $context);

    state: УдалитьПоследнийЧек
        q!: (~удалить|удали) (последний|предыдущий|прошлый) [~чек]

        script:
            addAction({ type: "delete_last_receipt" }, $context);

    state: ЭкспортДанных
        q!: (~экспортировать|экспортируй|~выгрузить|выгрузи) [~данные|~чеки|~всё]
        q!: (~сделать|сделай) (~бэкап|~резервную|~копию)

        script:
            addAction({ type: "export_data" }, $context);