theme: /

    state: ОтменаВвода
        q!: (отмена|отменить|отмени|стоп|stop|cancel)
        q!: (неважно|забудь|забыть|ничего)
        q!: [еще] не [нужно|надо] [добавлять|записывать]
        # Явные фразы из двух слов
        q!: не надо
        q!: не нужно

        script:
            addAction({ type: "cancel_pending" }, $context);

    state: ОтменаПоследнего
        q!: (~отменить|отмени) (последнее|последний|последнюю) [~добавление|~товар|~позицию]
        q!: удали последнее [~добавление|~что добавил|~что добавила]
        q!: (убери|удали) то что [только что] (~добавить|~записать|добавил|добавила|записал|записала)

        script:
            addAction({ type: "undo_last_item" }, $context);