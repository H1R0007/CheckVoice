theme: /

    state: ОтменаВвода
        q!: (отмена|отменить|отмени|стоп|stop|cancel)
        q!: (неважно|забудь|забыть|ничего)
        q!: не (надо|нужно)

        script:
            cancelPending($context);
            $reactions.answer("Последний ввод отменён.");

    state: ОтменаПоследнего
        q!: (~отменить|отмени) (последнее|последний|последнюю) [~добавление|~товар]
        q!: удали последнее

        script:
            undoLastItem($context);